#!/bin/sh
# archplan exporter for Elixir/Mix projects.
#
#   archplan-elixir export [-C MIX_DIR] [-o FILE] [--config FILE] [--sequences DIR] [--no-sequences]
#   archplan-elixir trace  [-C MIX_DIR] [--canary] [MIX_TASK [ARGS...]]
#
# export writes an archmodel/1 file (stdout without -o).
# trace runs a mix test task (default: test) with the ArchplanTrace formatter
# and writes one trace file per test to <repo root>/.archplan/sequences.
# --canary notes which calls receive the canary marker that tests send.
# -C names the Mix project directory (default: the current directory).
# Paths are relative to the directory you run this from.
set -eu

here=$(cd "$(dirname "$0")" && pwd)

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

[ $# -ge 1 ] || usage
cmd=$1
shift

dir=.
if [ "${1:-}" = "-C" ]; then
  [ $# -ge 2 ] || usage
  dir=$2
  shift 2
fi

abs() {
  case $1 in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$PWD/$1" ;;
  esac
}

# OTP 29 deprecates `catch`; older dependencies (such as meck) then fail to
# compile when warnings are errors. Keep a value the caller set.
ERL_COMPILER_OPTIONS=${ERL_COMPILER_OPTIONS:-[nowarn_deprecated_catch]}
export ERL_COMPILER_OPTIONS

case $cmd in
  export)
    # Make path options absolute before changing to the Mix project.
    n=$#
    i=0
    while [ $i -lt $n ]; do
      a=$1
      shift
      i=$((i + 1))
      case $a in
        -o | --output | --config | --sequences | --root)
          [ $i -lt $n ] || usage
          set -- "$@" "$a" "$(abs "$1")"
          shift
          i=$((i + 1))
          ;;
        *) set -- "$@" "$a" ;;
      esac
    done
    cd "$dir"
    # mix eval compiles and configures the project without starting it.
    # (mix run would also work, unless the project aliases run, as Phoenix
    # projects sometimes do.)
    ARCHPLAN_EXPORT_SCRIPT="$here/archplan_export.exs" exec mix eval \
      'Code.eval_file(System.fetch_env!("ARCHPLAN_EXPORT_SCRIPT"))' "$@"
    ;;
  trace)
    cd "$dir"
    if [ "${1:-}" = "--canary" ]; then
      ARCHPLAN_CANARY=1
      export ARCHPLAN_CANARY
      shift
    fi
    [ $# -ge 1 ] || set -- test
    task=$1
    shift
    MIX_ENV=${MIX_ENV:-test} exec elixir -r "$here/archplan_trace.ex" -S mix "$task" "$@" \
      --formatter ArchplanTrace --formatter ExUnit.CLIFormatter
    ;;
  *) usage ;;
esac
