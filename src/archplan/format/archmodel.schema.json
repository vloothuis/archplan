{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archplan.dev/schema/archmodel-1.json",
  "title": "archmodel v1",
  "type": "object",
  "required": ["format"],
  "properties": {
    "format": { "const": "archmodel/1" },
    "source": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "ref": { "type": "string" },
        "dirty": { "type": "boolean" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "module": { "type": "string" },
        "generator": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "commands": {
          "type": "object",
          "properties": {
            "build": { "type": "string" },
            "test": { "type": "string" },
            "rules": { "type": "string" },
            "sequences": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "match": { "type": "array", "items": { "type": "string" } },
          "layer": { "type": "string" },
          "kind": { "enum": ["internal", "external"] },
          "doc": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1 },
          "typeOnly": { "type": "integer", "minimum": 0 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "enum": ["allow", "deny"] },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "effect"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "effect": { "enum": ["allow", "deny"] },
              "note": { "type": "string" }
            }
          }
        },
        "enforcer": {
          "type": "object",
          "properties": {
            "tool": { "type": "string" },
            "config": { "type": "string" },
            "command": { "type": "string" }
          }
        }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "component", "kind"],
        "properties": {
          "name": { "type": "string" },
          "component": { "type": "string" },
          "kind": { "enum": ["struct", "class", "interface", "record", "enum", "alias", "function", "module"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "doc": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "ref": { "type": "string" },
                "ptr": { "type": "boolean" },
                "many": { "type": "boolean" }
              }
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": { "name": { "type": "string" }, "sig": { "type": "string" } }
            }
          },
          "implements": { "type": "array", "items": { "type": "string" } },
          "uses": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sequences": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["participants", "messages"],
        "properties": {
          "title": { "type": "string" },
          "entry": { "type": "string" },
          "source": { "type": "string" },
          "participants": { "type": "array", "items": { "type": "string" } },
          "stitched": { "type": "array", "items": { "type": "string" } },
          "guards": { "enum": ["off"] },
          "fragments": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["loop", "alt", "opt", "par"] },
                "label": { "type": "string" },
                "parent": { "type": ["string", "null"] }
              }
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "from", "to", "label"],
              "properties": {
                "id": { "type": "string" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string" },
                "depth": { "type": "integer", "minimum": 0 },
                "fragment": { "type": "string" },
                "async": { "type": "boolean" },
                "via": { "type": "string" },
                "outcome": { "type": "string" },
                "route": {
                  "type": "object",
                  "required": ["path"],
                  "properties": { "method": { "type": "string" }, "path": { "type": "string" } }
                },
                "span": { "type": "string" },
                "handler": { "type": "string" },
                "joined": { "const": "route" }
              }
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "description": "HTTP routes and the functions that serve them.",
      "items": {
        "type": "object",
        "required": ["method", "pattern"],
        "properties": {
          "method": { "type": "string" },
          "pattern": { "type": "string" },
          "handler": { "type": "string" },
          "component": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    },
    "schema": {
      "type": "object",
      "description": "Database tables, their owner components and who reads or writes them.",
      "properties": {
        "sources": {"type": "array", "items": {"type": "object", "required": ["kind"],
          "properties": {"kind": {"enum": ["django", "ecto", "rails", "prisma", "sql", "sqlite", "postgres"]},
            "path": {"type": "string"}}}},
        "tables": {"type": "object", "additionalProperties": {"type": "object",
          "properties": {
            "columns": {"type": "array", "items": {"type": "object", "required": ["name", "type", "null"],
              "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "null": {"type": "boolean"},
                "default": {"type": "string"}, "values": {"type": "array", "items": {"type": "string"}}}}},
            "pk": {"type": "array", "items": {"type": "string"}},
            "fks": {"type": "array", "items": {"type": "object", "required": ["columns", "to"],
              "properties": {"columns": {"type": "array", "items": {"type": "string"}}, "to": {"type": "string"},
                "to_columns": {"type": "array", "items": {"type": "string"}}, "on_delete": {"type": "string"}}}},
            "indexes": {"type": "array", "items": {"type": "object", "required": ["columns", "unique"],
              "properties": {"columns": {"type": "array", "items": {"type": "string"}}, "unique": {"type": "boolean"}}}},
            "checks": {"type": "array", "items": {"type": "string"}},
            "comment": {"type": "string"}}}},
        "enums": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "maps": {"type": "object", "additionalProperties": {"type": "object",
          "properties": {"type": {"type": "string"}, "component": {"type": "string"}, "via": {"type": "string"}}}},
        "access": {"type": "array", "items": {"type": "object", "required": ["component", "table", "mode"],
          "properties": {"component": {"type": "string"}, "table": {"type": "string"},
            "mode": {"enum": ["read", "write", "orm"]}, "weight": {"type": "integer"},
            "evidence": {"type": "array", "items": {"type": "string"}}}}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "vocabulary": {
      "type": "object",
      "properties": {
        "concepts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "owner": { "type": "string" },
              "terms": { "type": "array", "items": { "type": "string" } },
              "kind": { "enum": ["domain", "vendor", "technical"] },
              "definition": { "type": "string" },
              "source": { "enum": ["glossary", "vendor", "suggested"] }
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "uses": { "type": "array", "items": { "type": "string" } },
              "avoid": { "type": "array", "items": { "type": "string" } },
              "suggested": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["term", "score"],
                  "properties": { "term": { "type": "string" }, "score": { "type": "number" } }
                }
              }
            }
          }
        },
        "usage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component", "concept"],
            "properties": {
              "component": { "type": "string" },
              "concept": { "type": "string" },
              "idents": { "type": "integer", "minimum": 0 },
              "strings": { "type": "integer", "minimum": 0 },
              "comments": { "type": "integer", "minimum": 0 },
              "evidence": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "key", "value"],
        "properties": {
          "target": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["component", "function", "entrypoint"] },
              "id": { "type": "string" }
            }
          },
          "key": { "enum": ["zone", "gateway", "gated_by", "guard", "sink", "validates", "interprets", "source", "trusts", "auth"] },
          "value": { "type": ["string", "boolean", "array"], "items": { "type": "string" } },
          "reason": { "type": "string" },
          "at": {
            "type": "object",
            "properties": { "file": { "type": "string" }, "line": { "type": "integer" }, "name": { "type": "string" } }
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "annotator": { "type": "string" }
        }
      }
    },
    "notes": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
