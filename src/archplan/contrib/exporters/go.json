{
  "name": "go",
  "title": "Go (go/packages)",
  "languages": [
    "go"
  ],
  "priority": 80,
  "detect": {
    "manifests": {
      "go.mod": []
    }
  },
  "command": "go run github.com/vloothuis/archplan/exporters/archplan-go@latest -o {out}",
  "check": {
    "programs": [
      "go"
    ]
  },
  "capabilities": [
    "components",
    "types",
    "fields",
    "deps",
    "files",
    "calls",
    "signatures",
    "literals"
  ],
  "install": "Install Go 1.22 or newer from https://go.dev/dl/; the exporter runs with go run.",
  "runs_repo_code": true
}
